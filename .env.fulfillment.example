# Copy to .env.fulfillment; no production credentials are committed.
FULFILLMENT_MODE=shadow
FULFILLMENT_SITE=SET_YOUR_VISUAL_SITE
FULFILLMENT_DB_PASSWORD=replace-with-a-long-random-password
# URL-encode password characters in this URL.
FULFILLMENT_DATABASE_URL=postgresql+psycopg://dispatch:replace-with-a-long-random-password@dispatch-db:5432/dispatch
FULFILLMENT_MSSQL_CONNECTION_STRING=
FULFILLMENT_HOST=dispatch.local
FULFILLMENT_PUBLIC_ORIGIN=https://dispatch.local:8443
FULFILLMENT_LABEL_TOKEN=
FULFILLMENT_VALIDATE_TOKEN=
# Separate 32+ character bearer credential for inbound receipt, work-order and reconciliation events.
FULFILLMENT_INVENTORY_TOKEN=
# Separate 32+ character bearer credential for idempotent existing-VISUAL-order intake.
# Does not authorize creating commercial orders in VISUAL or inventory events.
FULFILLMENT_ORDER_TOKEN=
# Read-only inventory connector (run separately with python -m fulfillment.inventory_connector).
# Must match the site/warehouse/location saved in Dispatch > Inventory > Sync & warehouse.
FULFILLMENT_INVENTORY_WAREHOUSE=SHIPPING
# One configurable location inside SHIPPING; match the location saved in Dispatch.
FULFILLMENT_INVENTORY_LOCATION=
FULFILLMENT_INVENTORY_API_ORIGIN=https://dispatch.local:8443
# Durable local disk; back up with the Dispatch DB. Never delete to restart a stream.
FULFILLMENT_INVENTORY_OUTBOX=data/inventory-connector.db
# For a private TLS CA, set REQUESTS_CA_BUNDLE to its PEM file on the connector host.
# Rules and timezone are managed in Dispatch Admin, not the legacy database.
