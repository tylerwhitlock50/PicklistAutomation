# Copy to .env.fulfillment; no production credentials are committed.
FULFILLMENT_MODE=shadow
FULFILLMENT_SITE=SET_YOUR_VISUAL_SITE
FULFILLMENT_DB_PASSWORD=replace-with-a-long-random-password
# URL-encode password characters in this URL.
FULFILLMENT_DATABASE_URL=postgresql+psycopg://dispatch:replace-with-a-long-random-password@dispatch-db:5432/dispatch
FULFILLMENT_MSSQL_CONNECTION_STRING=
FULFILLMENT_LEGACY_DB=data/picklist_history.db
FULFILLMENT_HOST=dispatch.local
FULFILLMENT_PUBLIC_ORIGIN=https://dispatch.local:8443
FULFILLMENT_LABEL_TOKEN=
FULFILLMENT_VALIDATE_TOKEN=
SCHEDULE_TIMEZONE=America/Denver
