FLASK_SECRET_KEY=change-this
PORT=5000
LOG_LEVEL=INFO
FLASK_DEBUG=false

# Dashboard: seconds between status API polls when idle (faster while a run is active)
UI_REFRESH_INTERVAL_SECONDS=5

# SQL query file paths + default picklist mode (guns/components)
GUNS_QUERY_FILE=sql/query_guns.sql
COMPONENTS_QUERY_FILE=sql/query_components.sql
DEFAULT_QUERY_TYPE=guns
MAX_RUNS_TO_KEEP=10
RUN_HISTORY_DB_PATH=data/picklist_history.db

# Shipping ops (all optional — sensible defaults)
# RECON_SHIPMENTS_FILE=sql/recon_shipments.sql
# PICK_SERIAL_LOOKUP_FILE=sql/pick_serial_lookup.sql
# PICK_UPC_LOOKUP_FILE=sql/pick_upc_lookup.sql
# Days of daily picklist plan snapshots kept for end-of-day reconciliation
# PLAN_SNAPSHOT_RETENTION_DAYS=60
# Staged shipments should leave within this many hours
# STAGE_AGING_TARGET_HOURS=48
# SHIPPING locations containing this term count as stage bins
# STAGE_LOCATION_TERM=STAGE
# Component shortage report: horizon, product codes in scope, ERP cache
# SHORTAGE_QUERY_FILE=sql/shortage_components.sql
# SHORTAGE_LOOKAHEAD_DAYS=10
# SHORTAGE_PRODUCT_CODES=FG-COMP,FG-STOCK,FG-APPAREL,COMPONENT,FG-BASE,FG-RING,FG-BARREL,FG-MUZZLE
# SHORTAGE_CACHE_MINUTES=5
# Excess packlist cost report: query file, $ per avoidable extra box, ERP cache
# EXCESS_PACKLISTS_FILE=sql/excess_packlists.sql
# EXCESS_PACKLIST_COST_USD=51  (settings page overrides)
# EXCESS_CACHE_MINUTES=5
# JP / SLT shipping scorecard: raw order + packlist facts and ERP cache
# SHIPPING_METRICS_FILE=sql/shipping_metrics.sql
# SHIPPING_METRICS_CACHE_MINUTES=5
# Order release gate: advisory is the safe rollout default; settings page overrides
# RELEASE_CANDIDATES_FILE=sql/release_candidates.sql
# RELEASE_SERIAL_SUPPLY_FILE=sql/release_serial_supply.sql
# RELEASE_SHIPTO_HISTORY_FILE=sql/release_shipto_history.sql
# RELEASE_GATE_MODE=advisory
# RELEASE_GATE_DUE_OVERRIDE_DAYS=1
# RELEASE_GATE_CACHE_SECONDS=60
# Global ship-to cooldown floor (days). Guarantees a customer/ship-to released or
# shipped today is not released again the same day, regardless of per-customer policy.
# RELEASE_GATE_MIN_SHIP_TO_COOLDOWN_DAYS=1
# DEFAULT applies to standard stores; overrides are keyed by exact VISUAL customer ID.
# RELEASE_GATE_CUSTOMER_POLICIES_JSON={"DEFAULT":{"account_type":"standard","accumulate":true,"target_guns":0,"mix_orders":true,"release_cadence":"daily","daily_release_time":"14:00","max_hold_days":7,"ship_to_cooldown_days":1},"LIPSEYS":{"account_type":"major","accumulate":true,"target_guns":42,"mix_orders":false,"release_cadence":"threshold","daily_release_time":"14:00","max_hold_days":7,"ship_to_cooldown_days":0}}
# Max picklist generations per list per rolling 24h (0 = unlimited; settings page overrides)
# MAX_RUNS_PER_DAY=0

# Use SQLAlchemy connection format for pyodbc
# Example:
# MSSQL_CONNECTION_STRING=mssql+pyodbc://username:password@server/database?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
MSSQL_CONNECTION_STRING=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=
SMTP_RECIPIENT=
SMTP_USE_TLS=true

# Scheduler
ENABLE_SCHEDULER=true
SCHEDULE_TIME=05:00
# Example for Mountain local time (DST-aware): America/Denver
# Example for fixed MST year-round (UTC-7): Etc/GMT+7
SCHEDULE_TIMEZONE=UTC

# Access control for factory/local network use:
# - private: allow private/loopback clients (default)
# - cidr: allow only ACCESS_ALLOWED_CIDRS
# - off: disable checks
ACCESS_MODE=private
ACCESS_ALLOWED_CIDRS=
TRUST_PROXY_HEADERS=false

# Settings page unlock password (simple gate for /settings UI)
SETTINGS_PASSWORD=InforSystem

# Optional: encrypt sensitive settings stored in SQLite
# Generate with:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_ENCRYPTION_KEY=

# PG login
DATABASE_URL=

# --- Teams notifications (incoming webhook via Teams Workflows) ---
# Settings page values override these.
TEAMS_WEBHOOK_URL=
# Comma-separated event names, "all", or "none". Blank = sensible defaults.
TEAMS_ENABLED_EVENTS=
# Plant-local HH:MM for the daily shipped + tracking digest.
TEAMS_DIGEST_TIME=16:30
# Public base URL used for deep links in Teams cards, e.g. http://ops.local:8081
APP_PUBLIC_URL=
# Operator roster for the name picker: JSON list of {"name","team","email"}; team in sales|shipping|finance|management
OPERATOR_ROSTER_JSON=

# --- Order readiness (Orders page / Shipping > Holds) ---
# How far ahead (days) the readiness query looks for open orders.
READINESS_LOOKAHEAD_DAYS=30
# Background re-evaluation cadence in minutes (0 disables the job; the Orders page can still re-check on demand).
READINESS_REFRESH_MINUTES=15
# Minimum seconds between two evaluations triggered by page refreshes.
READINESS_CACHE_SECONDS=300
# Overdue orders older than this many days are hidden from the default list views (still reachable via "Everything").
READINESS_STALE_DAYS=60
# SHIP_CREDIT_LIMIT_CTL codes that mean VISUAL checks the credit limit at ship time (comma-separated).
READINESS_CREDIT_CHECK_CODES=C
# Require an FFL / EZ Check attachment on firearms orders (advisory hold when missing).
READINESS_REQUIRE_FFL_DOC=true

# --- Shipments / stock lookups and the daily Teams digest ---
# How often (minutes) the scheduler checks whether the shipped-today digest is due.
SHIPPED_DIGEST_CHECK_MINUTES=5
# Widest date range the shipments lookup will query at once.
SHIPMENTS_LOOKUP_MAX_DAYS=120

# --- Requests and sanctioned holds ---
# Override SLA hours per request type (defaults: ship_request 4, hold_exception 8,
# inventory_discrepancy 24, order_problem 24).
REQUEST_SLA_HOURS_JSON={}
# Longest an accepted expedite keeps its release-gate exception open (hours).
REQUEST_EXPEDITE_MAX_HOURS=72

# --- FFL document checks (readiness tier 2, optional) ---
# Read the EZ Check / FFL copy attached to each firearms order and compare the
# licensee name and premise with the ship-to. Needs the document share mounted
# (see docker-compose.yml) and, for scanned PDFs, poppler + tesseract in the image.
READINESS_OCR_ENABLED=false
# Where VISUAL's DOC_FILE_PATH values live inside the container, and the prefix map.
DOCUMENT_ROOTS=/mnt/carms
DOCUMENT_PATH_MAP=V:\=/mnt/carms;\\2CARMS\CARMS$=/mnt/carms
# OCR tuning: render DPI, pages per document, documents read per refresh (cached after).
READINESS_OCR_DPI=200
READINESS_OCR_PAGES=2
READINESS_OCR_MAX_DOCS_PER_RUN=20
# Similarity thresholds (0-1) for name and street comparison.
READINESS_FFL_NAME_THRESHOLD=0.60
READINESS_FFL_ADDR_THRESHOLD=0.75
# CIFS credentials for the optional documents volume (docker-compose.documents.yml).
# The app starts without them; the share is only mounted when you include that file.
SMB_DEVICE=//2CARMS/CARMS$
SMB_USERNAME=
SMB_PASSWORD=
SMB_DOMAIN=
